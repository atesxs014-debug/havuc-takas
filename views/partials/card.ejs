<% const k = getKategori(ilan.category); %>
<a class="kart" href="<%= ilanUrl(ilan) %>">
  <div class="kart-gorsel" style="--r1:<%= k.renk[0] %>;--r2:<%= k.renk[1] %>">
    <% if (ilan.image) { %><img src="/uploads/<%= ilan.image %>" alt="<%= ilan.title %>" loading="lazy"><% } else { %><%- k.ikon %><% } %>
    <% if (ilan.status === 'sold') { %><span class="kart-etiket">Takas edildi</span><% } %>
    <% if (ilan.status === 'pending') { %><span class="kart-etiket">⏳ İncelemede</span><% } %>
    <% if (ilan.status === 'rejected') { %><span class="kart-etiket">Yayınlanmadı</span><% } %>
    <% if (favs.has(ilan.id)) { %><span class="kart-fav" title="Favorilerinde">❤️</span><% } %>
  </div>
  <div class="kart-govde">
    <div class="rozetler">
      <% if (ilan.price != null) { %><span class="fiyat-rozet"><%= fiyat(ilan.price) %></span><% } %>
      <% if (ilan.is_swap) { %><span class="takas-rozet">Takaslık</span><% } %>
      <% if (ilan.shipping && ilan.price != null) { %><span class="kargo-rozet" title="Kargoyla güvenli satın alınabilir">📦 Kargo</span><% } %>
    </div>
    <h3 class="kart-baslik"><%= ilan.title %></h3>
    <p class="kart-alt"><%= ilan.views %> görüntülenme<% if (typeof konumGoster !== 'undefined' && konumGoster) { %> · <%= konumAdi(ilan.il, ilan.ilce) %><% } %></p>
  </div>
</a>
