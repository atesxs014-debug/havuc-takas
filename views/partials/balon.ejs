<div class="balon <%= m.sender_id === user.id ? 'benim' : '' %><%= m.image ? ' fotolu' : '' %>" data-id="<%= m.id %>"><% if (m.image) { %><a href="/uploads/<%= m.image %>" target="_blank" rel="noopener" class="balon-foto"><img src="/uploads/<%= m.image %>" alt="Gönderilen fotoğraf" loading="lazy"></a><% } %><% if (m.body) { %><span class="balon-metin"><%= m.body %></span><% } %><small><%= tarihSaat(m.created_at) %></small></div>
