<%- include('partials/head') %>
<h1 class="sayfa-baslik"><%= il ? (ilce ? ilce.ad + ', ' + il.ad : il.ad) + ' İlanları' : 'İlanlar' %> <small>(<%= toplam %> sonuç)</small></h1>

<form class="filtre" method="get" action="/ilanlar" id="filtreForm">
  <div class="arama">
    <input type="search" name="q" value="<%= filtre.q %>" placeholder="🔍 İlan başlığı veya açıklamasında ara..." aria-label="Ara">
    <button class="btn btn-yesil">Ara</button>
  </div>
  <button type="button" class="filtre-ac" aria-expanded="<%= ekFiltre ? 'true' : 'false' %>" aria-controls="filtreKutu" data-filtre-ac>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg> Filtreler<% if (ekFiltre) { %> <span class="filtre-nokta" aria-label="aktif"></span><% } %>
  </button>
  <div class="filtre-kutu<%= ekFiltre ? ' acik' : '' %>" id="filtreKutu">
    <label>Sırala
      <select name="sirala">
        <% [['yeni','En Yeni'],['eski','En Eski'],['fiyat-artan','Fiyat (Düşükten Yükseğe)'],['fiyat-azalan','Fiyat (Yüksekten Düşüğe)'],['populer','En Çok Görüntülenen']].forEach(function (s) { %>
          <option value="<%= s[0] %>" <%= filtre.sirala === s[0] ? 'selected' : '' %>><%= s[1] %></option>
        <% }) %>
      </select>
    </label>
    <label class="filtre-konum">İl / İlçe
      <span class="select-ikili"><%- include('partials/location-select', { secIl: filtre.il, secIlce: filtre.ilce, ilBos: 'Tüm Türkiye', ilceBos: 'Tüm İlçeler' }) %></span>
    </label>
    <label>Kategori
      <select name="kategori">
        <option value="">Tüm Kategoriler</option>
        <% kategoriler.forEach(function (k) { %><option value="<%= k.slug %>" <%= filtre.kategori === k.slug ? 'selected' : '' %>><%= k.ad %></option><% }) %>
      </select>
    </label>
    <label>İlan Türü
      <select name="tip">
        <option value="">Hepsi</option>
        <option value="satilik" <%= filtre.tip === 'satilik' ? 'selected' : '' %>>Satılık</option>
        <option value="takas" <%= filtre.tip === 'takas' ? 'selected' : '' %>>Takaslık</option>
      </select>
    </label>
    <label>Ürün Durumu
      <select name="durum">
        <option value="">Hepsi</option>
        <% DURUMLAR.forEach(function (d) { %><option value="<%= d[0] %>" <%= filtre.durum === d[0] ? 'selected' : '' %>><%= d[1] %></option><% }) %>
      </select>
    </label>
    <label>Fiyat (TL)
      <span class="fiyat-aralik"><input name="fmin" inputmode="numeric" placeholder="En az" value="<%= filtre.fmin != null ? filtre.fmin : '' %>" aria-label="En az fiyat"><span>–</span><input name="fmax" inputmode="numeric" placeholder="En çok" value="<%= filtre.fmax != null ? filtre.fmax : '' %>" aria-label="En çok fiyat"></span>
    </label>
    <button class="btn btn-yesil filtre-btn">Filtrele</button>
  </div>
</form>

<% if (filtre.q || filtre.il || filtre.kategori) { %>
  <% if (!user) { %>
    <p class="arama-kaydet-satir"><a href="/giris?next=<%= encodeURIComponent(path + '?' + new URLSearchParams(query).toString()) %>">🔔 Giriş yap, bu aramaya uygun ilan çıkınca haber verelim</a></p>
  <% } else if (aramaKayitli) { %>
    <p class="arama-kaydet-satir">🔔 Bu arama kayıtlı. <a href="/aramalarim">Aramalarım</a></p>
  <% } else { %>
    <form method="post" action="/aramalarim" class="arama-kaydet-satir">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <% ['q','il','ilce','kategori','tip','durum','fmin','fmax'].forEach(function (k) { if (filtre[k] != null && filtre[k] !== '') { %><input type="hidden" name="<%= k %>" value="<%= filtre[k] %>"><% } }) %>
      <button class="btn btn-cizgi btn-mini">🔔 Bu aramayı kaydet, yeni ilan çıkınca haber ver</button>
    </form>
  <% } %>
<% } %>

<% if (reklamlar) { %>
  <%- include('partials/ad-slots', { reklamlar, reklamIl: il.slug, reklamIlce: ilce ? ilce.slug : '', reklamKonum: ilce ? ilce.ad : il.ad }) %>
<% } %>

<% if (il && !ilce) { %>
  <details class="ilce-liste">
    <summary><%= il.ad %> ilçeleri (<%= il.ilceler.length %>)</summary>
    <div class="cipler"><% il.ilceler.forEach(function (i) { %><a href="/il/<%= il.slug %>/<%= i.slug %>"><%= i.ad %></a><% }) %></div>
  </details>
<% } %>

<% if (ilanlar.length) { %>
  <div class="grid"><% ilanlar.forEach(function (ilan) { %><%- include('partials/card', { ilan, konumGoster: true }) %><% }) %></div>
  <% if (sayfaSayisi > 1) {
       const qs = function (p) { const o = Object.assign({}, filtre, { sayfa: p }); return '/ilanlar?' + Object.keys(o).filter(function (k) { return o[k]; }).map(function (k) { return k + '=' + encodeURIComponent(o[k]); }).join('&'); }; %>
    <nav class="sayfalama">
      <% if (sayfa > 1) { %><a href="<%= qs(sayfa - 1) %>">← Önceki</a><% } %>
      <span><%= sayfa %> / <%= sayfaSayisi %></span>
      <% if (sayfa < sayfaSayisi) { %><a href="<%= qs(sayfa + 1) %>">Sonraki →</a><% } %>
    </nav>
  <% } %>
<% } else { %>
  <div class="bos-durum">
    <p>Bu kriterlere uygun ilan bulunamadı.</p>
    <a class="btn btn-yesil" href="/ilan-ver">+ İlk ilanı sen ver</a>
  </div>
<% } %>
<%- include('partials/foot') %>
