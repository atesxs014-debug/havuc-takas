<%- include('partials/head') %>
<nav class="breadcrumb">
  <a href="/">Anasayfa</a> › <a href="/ilanlar?kategori=<%= kategori.slug %>"><%= kategori.ad %></a> › <span><%= ilan.title %></span>
</nav>

<% if (ilan.status === 'pending') { %><div class="flash flash-info">⏳ Bu ilan incelemede, şu an sadece sen<%= user && user.is_admin ? ' ve yöneticiler' : '' %> görebilirsin.<% if (user && user.is_admin && ilan.mod_reason) { %> Yakalanan: <%= ilan.mod_reason %><% } %></div><% } %>
<% if (ilan.status === 'expired') { %><div class="flash flash-info">⌛ Bu ilanın yayın süresi doldu.<% if (isOwner) { %> <form method="post" action="/ilan/<%= ilan.id %>/yenile" class="satir-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn">Tek tıkla 30 gün yenile</button></form><% } %></div><% } %>
<% if (ilan.status === 'banned' || ilan.seller_banned) { %><div class="flash flash-error">Bu ilanın sahibi engellendiği için ilan yayında değil.</div><% } %>
<% if (query.vitrin === 'ok') { %><div class="flash flash-success">⭐ Ödemen alındı, ilanın vitrinde!</div><% } else if (query.vitrin === 'hata') { %><div class="flash flash-error">Vitrin ödemesi tamamlanmadı.</div><% } else if (query.vitrin === 'dogrulanamadi') { %><div class="flash flash-error">Ödeme sonucu doğrulanamadı. Kartından çekim yapıldıysa bize ulaş.</div><% } %>
<% if (ilan.status === 'rejected') { %><div class="flash flash-error">Bu ilan kurallara uymadığı için yayınlanmadı.</div><% } %>
<div class="detay">
  <div class="detay-sol">
    <div class="galeri" data-galeri>
      <div class="detay-gorsel" style="--r1:<%= kategori.renk[0] %>;--r2:<%= kategori.renk[1] %>">
        <% if (fotolar.length) { %><img src="/uploads/<%= fotolar[0].file %>" alt="<%= ilan.title %>" data-galeri-ana><% } else { %><%- kategori.ikon %><% } %>
        <% if (ilan.status === 'sold') { %><span class="kart-etiket">Takas edildi / Satıldı</span><% } %>
        <% if (vitrinde && ilan.status === 'active') { %><span class="vitrin-rozet buyuk">⭐ Vitrin</span><% } %>
        <% if (fotolar.length > 1) { %>
          <button type="button" class="galeri-ok sol" data-galeri-onceki aria-label="Önceki fotoğraf">‹</button>
          <button type="button" class="galeri-ok sag" data-galeri-sonraki aria-label="Sonraki fotoğraf">›</button>
          <span class="galeri-sayac" data-galeri-sayac>1 / <%= fotolar.length %></span>
        <% } %>
      </div>
      <% if (fotolar.length > 1) { %>
        <div class="galeri-kucuk">
          <% fotolar.forEach(function (f, i) { %>
            <button type="button" class="<%= i === 0 ? 'secili' : '' %>" data-galeri-src="/uploads/<%= f.file %>" aria-label="Fotoğraf <%= i + 1 %>"><img src="/uploads/<%= f.thumb %>" alt="" loading="lazy"></button>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="detay-sag">
    <div class="baslik-satir">
      <h1 class="detay-baslik"><%= ilan.title %></h1>
      <% if (!isOwner) { const fav = favs.has(ilan.id); %>
        <form method="post" action="/ilan/<%= ilan.id %>/favori" class="fav-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="islem" value="<%= fav ? 'cikar' : 'ekle' %>">
          <button class="fav-btn <%= fav ? 'aktif' : '' %>" aria-pressed="<%= fav %>" aria-label="<%= fav ? 'Favorilerden çıkar' : 'Favorilere ekle' %>" title="<%= fav ? 'Favorilerden çıkar' : 'Favorilere ekle' %>"><span><%= fav ? '❤️' : '🤍' %></span> <small><%= favSayisi %></small></button>
        </form>
      <% } %>
    </div>
    <p class="detay-meta">📍 <a href="/il/<%= ilan.il %>/<%= ilan.ilce %>"><%= konumAdi(ilan.il, ilan.ilce) %></a> · <%= ilan.views %> görüntülenme · <%= tarih(ilan.created_at) %></p>
    <p class="detay-fiyat">
      <% if (ilan.price != null) { %><%= fiyat(ilan.price) %><% } %>
      <% if (ilan.is_swap) { %><span class="takas-rozet buyuk"><%= ilan.price != null ? 'Takasa da açık' : 'Takaslık' %></span><% } %>
    </p>
    <% if (durumAd) { %><p class="durum-satir"><span class="durum-rozet"><%= durumAd %></span></p><% } %>
    <div class="detay-aciklama"><%= ilan.description %></div>

    <div class="satici-kart">
      <div class="satici">
        <span class="avatar"><%= ilan.seller_name.charAt(0).toLocaleUpperCase('tr') %></span>
        <div><a href="/uye/<%= ilan.user_id %>" class="satici-ad"><strong><%= ilan.seller_name %></strong></a>
          <small><% if (ilan.seller_reviews) { %>⭐ <%= ilan.seller_rating %> (<%= ilan.seller_reviews %> değerlendirme) · <% } %><%= new Date(ilan.seller_since.replace(' ', 'T') + 'Z').getFullYear() %>'den beri üye · <%= ilan.seller_count %> ilan</small></div>
      </div>
      <% if (isOwner) { %>
        <a class="btn btn-yesil tam" href="/ilan/<%= ilan.id %>/duzenle">✏️ İlanı Düzenle</a>
        <% if (['active', 'sold'].includes(ilan.status)) { %><form method="post" action="/ilan/<%= ilan.id %>/durum" class="sahip-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <% if (ilan.status === 'active') { %><button name="status" value="sold" class="btn btn-cizgi">✅ Takas edildi / Satıldı</button>
          <% } else { %><button name="status" value="active" class="btn btn-cizgi">Tekrar yayınla</button><% } %>
          <button name="status" value="removed" class="btn btn-cizgi kirmizi" data-confirm="İlan kaldırılsın mı?">🗑 Kaldır</button>
        </form><% } %>
        <% if (ilan.status === 'active' && ilan.expires_at) { %>
          <div class="kucuk sure-not">⌛ Yayında: <%= tarih(ilan.expires_at) %> tarihine kadar.
            <form method="post" action="/ilan/<%= ilan.id %>/yenile" class="satir-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn">Şimdi 30 gün uzat</button></form></div>
        <% } %>
        <% if (ilan.status === 'active' && vitrin && vitrinAcik) { %>
          <div class="vitrin-kutu">
            <% if (vitrinde) { %><p><strong>⭐ İlanın vitrinde</strong> · <%= tarih(ilan.featured_until) %> tarihine kadar. Süreyi uzatabilirsin:</p>
            <% } else { %><p><strong>⭐ İlanını öne çıkar</strong></p><p class="kucuk">Vitrindeki ilanlar il, ilçe ve arama sonuçlarında en üstte, rozetle görünür.</p><% } %>
            <form method="post" action="/ilan/<%= ilan.id %>/vitrin" class="vitrin-form">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <% vitrin.forEach(function (p, i) { %>
                <label class="vitrin-secenek"><input type="radio" name="gun" value="<%= p.gun %>" <%= i === 0 ? 'checked' : '' %>><span><strong><%= p.gun %> gün</strong><small><%= fiyat(p.fiyat) %></small></span></label>
              <% }) %>
              <button class="btn btn-turuncu tam">Kartla öde ve öne çıkar</button>
            </form>
          </div>
        <% } %>
      <% } else { %>
        <% if (kargo && !kargo.engel) { %>
          <div class="kargo-kutu">
            <p><strong>📦 Kargoyla güvenli satın al</strong></p>
            <p class="kucuk">Ürün <%= fiyat(kargo.tutar.urun) %> + kargo <%= fiyat(kargo.tutar.kargo) %> + hizmet bedeli <%= fiyat(kargo.tutar.hizmet) %></p>
            <a class="btn btn-turuncu tam" href="/ilan/<%= ilan.id %>/satin-al">Kargoyla Satın Al · <%= fiyat(kargo.tutar.toplam) %></a>
            <p class="kucuk">🔒 Paran, ürünü teslim alıp onaylayana kadar güvende bekler.</p>
          </div>
        <% } else if (kargo && ilan.status === 'active') { %>
          <p class="kucuk">📦 Kargoyla satışa açık · <%= kargo.engel %></p>
        <% } %>
        <a class="btn btn-yesil tam" href="/mesajlar/<%= ilan.id %>/<%= ilan.user_id %>">💬 Satıcıya Mesaj Gönder</a>
        <details class="sikayet">
          <summary>🚩 İlanı Şikayet Et</summary>
          <form method="post" action="/ilan/<%= ilan.id %>/sikayet">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <select name="reason" required>
              <option value="">Neden?</option>
              <option>Dolandırıcılık şüphesi</option>
              <option>Yasaklı ürün</option>
              <option>Yanlış kategori / bilgi</option>
              <option>Uygunsuz içerik</option>
              <option>Diğer</option>
            </select>
            <textarea name="detail" rows="2" maxlength="500" placeholder="Açıklama (isteğe bağlı)"></textarea>
            <button class="btn btn-cizgi">Gönder</button>
          </form>
        </details>
      <% } %>
    </div>
    <p class="guvenlik-not">🛡️ Site dışında ön ödeme yapmayın. Kargolu alışverişte yalnızca "Kargoyla Satın Al" butonunu kullanın. Halka açık bir yerde buluşun, ürünü görerek elden teslim alın. <a href="/guvenli-takas">Güvenli takas rehberi</a></p>
  </div>
</div>

<%- include('partials/ad-slots', { reklamlar, reklamIl: ilan.il, reklamIlce: ilan.ilce, reklamKonum: getIlce(ilan.il, ilan.ilce).ad }) %>

<% if (benzer.length) { %>
  <section>
    <div class="bolum-bas"><h2 class="bolum-baslik">Benzer ilanlar</h2><a class="kucuk-link" href="/ilanlar?il=<%= ilan.il %>&kategori=<%= ilan.category %>">Tümünü Gör →</a></div>
    <div class="grid"><% benzer.forEach(function (b) { %><%- include('partials/card', { ilan: b }) %><% }) %></div>
  </section>
<% } %>
<%- include('partials/foot') %>
