<%- include('partials/head') %>
<div class="sohbet">
  <a class="sohbet-ilan" href="<%= ilanUrl(ilan) %>">
    <span class="mini-gorsel" style="--r1:<%= getKategori(ilan.category).renk[0] %>;--r2:<%= getKategori(ilan.category).renk[1] %>"><% if (ilan.image) { %><img src="/uploads/<%= ilan.image %>" alt=""><% } else { %><%- getKategori(ilan.category).ikon %><% } %></span>
    <span><strong><%= ilan.title %></strong><small><%= ilan.price === 0 ? 'Bedava' : ilan.price != null ? fiyat(ilan.price) : 'Takaslık' %> · <%= other.name %></small></span>
  </a>
  <div class="mesajlar" data-canli="/mesajlar/<%= ilan.id %>/<%= other.id %>/yeni" data-son="<%= msgs.length ? msgs[msgs.length - 1].id : 0 %>">
    <% if (!msgs.length) { %><p class="kucuk merkez">Mesajın sadece <%= other.name %> tarafından görülür. Kibar ol, telefon/IBAN paylaşmadan önce emin ol. 🙂</p><% } %>
    <% msgs.forEach(function (m) { %><%- include('partials/balon', { m }) %><% }) %>
    <span id="son"></span>
  </div>
  <% if (puanlanabilir) { %>
    <form method="post" action="/ilan/<%= ilan.id %>/degerlendir" class="puan-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <strong>Takas tamamlandı! <%= other.name %>'ı değerlendir:</strong>
      <div class="yildizlar" role="radiogroup" aria-label="Puan">
        <% for (let i = 5; i >= 1; i--) { %><input type="radio" name="score" value="<%= i %>" id="y<%= i %>" required><label for="y<%= i %>" title="<%= i %> yıldız">★</label><% } %>
      </div>
      <input name="comment" maxlength="500" placeholder="Kısa bir yorum (isteğe bağlı)">
      <button class="btn btn-mini btn-yesil">Gönder</button>
    </form>
  <% } %>
  <% if (benEngelledim || engellendim) { %>
    <div class="engel-bant">
      <% if (benEngelledim) { %>🚫 <%= other.name %> kişisini engelledin, mesajlaşamazsınız.
        <form method="post" action="/engel/<%= other.id %>" class="satir-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="islem" value="kaldir"><input type="hidden" name="next" value="<%= path %>"><button class="linkbtn">Engeli kaldır</button></form>
      <% } else { %>🚫 Bu kişiye mesaj gönderemezsin.<% } %>
    </div>
  <% } else { %>
    <form method="post" class="mesaj-yaz" enctype="multipart/form-data" data-mesaj-form>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="foto-ekle" title="Fotoğraf ekle" aria-label="Fotoğraf ekle">
        <input type="file" name="photo" accept="image/*" data-mesaj-foto hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="3"/><circle cx="12" cy="12.5" r="3.5"/><path d="M8.5 5l1.5-2h4l1.5 2"/></svg>
      </label>
      <div class="mesaj-alan">
        <div class="foto-onizleme" data-foto-onizleme hidden><img alt=""><button type="button" aria-label="Fotoğrafı kaldır" data-foto-kaldir>×</button></div>
        <textarea name="body" rows="2" maxlength="2000" placeholder="<%= msgs.length ? 'Mesaj yaz...' : 'Merhaba, ilan hâlâ güncel mi?' %>"></textarea>
      </div>
      <button class="btn btn-yesil">Gönder</button>
    </form>
  <% } %>
  <div class="sohbet-alt">
    <% if (!benEngelledim) { %>
      <form method="post" action="/engel/<%= other.id %>" class="satir-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="islem" value="engelle"><input type="hidden" name="next" value="<%= path %>">
        <button class="linkbtn kirmizi-link" data-confirm="<%= other.name %> engellensin mi? Birbirinize mesaj gönderemeyeceksiniz.">🚫 <%= other.name %> kişisini engelle</button></form>
    <% } %>
  </div>
</div>
<%- include('partials/foot') %>
