<%- include('partials/head') %>
<h1 class="sayfa-baslik">Mesajlar</h1>
<% if (list.length) { %>
  <ul class="konusmalar">
    <% list.forEach(function (c) { %>
      <li class="<%= c.unread ? 'okunmamis' : '' %>">
        <a href="/mesajlar/<%= c.listing_id %>/<%= c.other_id %>">
          <span class="avatar"><%= c.other.name.charAt(0).toLocaleUpperCase('tr') %></span>
          <span class="konusma-govde">
            <strong><%= c.other.name %></strong> <small>· <%= c.ilan.title %></small>
            <span class="son-mesaj"><%= c.last.sender_id === user.id ? 'Sen: ' : '' %><%= c.last.body || (c.last.image ? '📷 Fotoğraf' : '') %></span>
          </span>
          <span class="konusma-sag"><small><%= tarihSaat(c.last.created_at) %></small><% if (c.unread) { %><span class="rozet"><%= c.unread %></span><% } %></span>
        </a>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <div class="bos-durum"><p>Henüz mesajın yok. Beğendiğin bir ilanda "Satıcıya Mesaj Gönder"e dokun.</p><a class="btn btn-yesil" href="/ilanlar">İlanlara göz at</a></div>
<% } %>
<%- include('partials/foot') %>
