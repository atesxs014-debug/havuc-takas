<%- include('partials/head') %>
<div class="form-sayfa">
  <h1 class="sayfa-baslik"><%= title %></h1>
  <% if (typeof error !== 'undefined' && error === 'KARGO_HESAP') { %>
    <div class="flash flash-error">Kargoyla satış için önce <a href="/hesabim/odeme-bilgileri?next=<%= encodeURIComponent(path) %>">ödeme bilgilerini</a> (IBAN ve kimlik) girmelisin. İstersen kargo seçeneğini kapatıp ilanı şimdi yayınlayabilirsin.</div>
  <% } else if (typeof error !== 'undefined' && error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <form method="post" enctype="multipart/form-data" class="form kart-form"
        action="<%= edit ? "/ilan/" + form.id + "/duzenle" : "/ilan-ver" %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Başlık<input name="title" required minlength="5" maxlength="90" value="<%= form.title || '' %>" placeholder="Örn. Az Kullanılmış Dağ Bisikleti"></label>
    <label>Kategori
      <select name="category" required>
        <option value="">Seçin</option>
        <% kategoriler.forEach(function (k) { %><option value="<%= k.slug %>" <%= form.category === k.slug ? 'selected' : '' %>><%= k.ad %></option><% }) %>
      </select>
    </label>
    <label>Ürünün durumu
      <select name="condition" required>
        <option value="">Seçin</option>
        <% DURUMLAR.forEach(function (d) { %><option value="<%= d[0] %>" <%= form.condition === d[0] ? 'selected' : '' %>><%= d[1] %></option><% }) %>
      </select>
    </label>
    <fieldset class="tur">
      <legend>İlan türü</legend>
      <label class="radio"><input type="radio" name="tur" value="satilik" <%= form.tur === 'satilik' ? 'checked' : '' %>> Satılık</label>
      <label class="radio"><input type="radio" name="tur" value="takas" <%= form.tur === 'takas' ? 'checked' : '' %>> Sadece takas</label>
      <label class="radio"><input type="radio" name="tur" value="ikisi" <%= form.tur === 'ikisi' ? 'checked' : '' %>> Satılık + takasa açık</label>
      <label class="radio"><input type="radio" name="tur" value="bedava" <%= form.tur === 'bedava' ? 'checked' : '' %>> 🎁 Bedava (hediye)</label>
    </fieldset>
    <label class="js-fiyat">Fiyat (TL)<input name="price" inputmode="numeric" value="<%= form.price != null ? form.price : '' %>" placeholder="3500"></label>
    <% if (kargoAcik) { %>
      <fieldset class="kargo-secim js-kargo">
        <legend>📦 Kargoyla satış <small class="kucuk">(isteğe bağlı)</small></legend>
        <label class="radio"><input type="checkbox" name="shipping" value="1" <%= form.shipping ? 'checked' : '' %>> <span>Uzaktaki alıcılar da <strong>güvenli ödemeyle</strong> satın alabilsin. Para, alıcı ürünü teslim alınca sana geçer.</span></label>
        <div class="kargo-detay">
          <% if (!hesapHazir) { %><p class="kucuk">ℹ️ Bunun için bir kez <a href="/hesabim/odeme-bilgileri?next=<%= encodeURIComponent(path) %>" target="_blank">ödeme bilgilerini</a> girmen gerekiyor.</p><% } %>
          <p class="kucuk">🚚 Ürünü <strong>alıcı ödemeli</strong> gönderirsin; kargo ücretini alıcı teslimatta kargo firmasına öder. Site komisyon veya kargo ücreti almaz.</p>
        </div>
      </fieldset>
    <% } %>
    <div class="iki-kolon">
      <%- include('partials/location-select', { secIl: form.il || '', secIlce: form.ilce || '', ilBos: 'İl seçin', ilceBos: 'İlçe seçin', zorunlu: true }) %>
    </div>
    <label>Açıklama<textarea name="description" rows="6" required minlength="10" maxlength="3000" placeholder="Ürünün durumu, kullanım süresi, kusurları..."><%= form.description || '' %></textarea></label>
    <% if (edit && fotolar.length) { %>
      <fieldset class="foto-yonet">
        <legend>Mevcut fotoğraflar</legend>
        <div class="foto-liste">
          <% fotolar.forEach(function (f, i) { %>
            <div class="foto-oge">
              <img src="/uploads/<%= f.thumb %>" alt="">
              <label class="radio"><input type="radio" name="cover_img" value="<%= f.id %>" <%= i === 0 ? 'checked' : '' %>> Kapak</label>
              <label class="radio"><input type="checkbox" name="remove_img" value="<%= f.id %>"> Sil</label>
            </div>
          <% }) %>
        </div>
      </fieldset>
    <% } %>
    <div class="dosya-alan">
      <span class="dosya-baslik">Fotoğraflar <small>(en fazla <%= MAX_FOTO %> adet, her biri en fazla 10 MB · otomatik küçültülür)</small></span>
      <label class="dosya-sec">
        <input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" multiple data-max="<%= MAX_FOTO - (edit ? fotolar.length : 0) %>" class="js-foto">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="3"/><circle cx="12" cy="12.5" r="3.5"/><path d="M8.5 5l1.5-2h4l1.5 2"/></svg>
        <span data-dosya-yazi>Fotoğraf seç</span>
      </label>
    </div>
    <div class="ilan-onizleme" id="fotoOnizleme"></div>
    <% if (!edit) { %><%- include('partials/turnstile') %><% } %>
    <button class="btn btn-yesil tam"><%= edit ? 'Kaydet' : 'İlanı Yayınla' %></button>
    <p class="kucuk">İlan vermek ücretsizdir. Yayınlayarak <a href="/kullanim-sartlari">Kullanım Şartları</a>'nı kabul etmiş olursunuz.</p>
  </form>
</div>
<%- include('partials/foot') %>
