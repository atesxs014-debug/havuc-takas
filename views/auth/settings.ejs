<%- include('../partials/head') %>
<div class="form-sayfa">
  <h1 class="sayfa-baslik">Hesap Ayarları</h1>
  <form method="post" action="/hesabim/ayarlar" class="form kart-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Ad Soyad<input name="name" required minlength="3" maxlength="80" value="<%= user.name %>"></label>
    <label>E-posta<input value="<%= user.email %>" disabled> <small><%= user.email_verified ? '✅ Doğrulandı' : '⚠️ Doğrulanmadı' %></small></label>
    <label>Telefon <small>(isteğe bağlı, ilanlarda gösterilmez)</small><input type="tel" name="phone" value="<%= user.phone || '' %>"></label>
    <label class="radio"><input type="checkbox" name="notify_email" value="1" <%= user.notify_email ? 'checked' : '' %>> Yeni mesaj gelince e-posta ile haber ver</label>
    <h2 class="form-baslik">Şifre değiştir <small class="kucuk">(isteğe bağlı)</small></h2>
    <div class="iki-kolon">
      <label>Mevcut şifre<input type="password" name="password" autocomplete="current-password"></label>
      <label>Yeni şifre<input type="password" name="new_password" minlength="8" autocomplete="new-password"></label>
    </div>
    <button class="btn btn-yesil tam">Kaydet</button>
  </form>
</div>
<%- include('../partials/foot') %>
