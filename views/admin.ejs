<%- include('partials/head') %>
<h1 class="sayfa-baslik">Yönetim Paneli</h1>
<nav class="sekmeler">
  <a href="?tab=bekleyen" class="<%= tab === 'bekleyen' ? 'aktif' : '' %>">Reklam başvuruları <span class="rozet"><%= c.bekleyen %></span></a>
  <a href="?tab=aktif" class="<%= tab === 'aktif' ? 'aktif' : '' %>">Aktif reklamlar (<%= c.aktif %>)<% if (c.uzatma) { %> <span class="rozet"><%= c.uzatma %> uzatma</span><% } %></a>
  <a href="?tab=gecmis" class="<%= tab === 'gecmis' ? 'aktif' : '' %>">Geçmiş</a>
  <a href="?tab=onay" class="<%= tab === 'onay' ? 'aktif' : '' %>">Onay bekleyen ilanlar <span class="rozet"><%= c.onay %></span></a>
  <a href="?tab=sikayet" class="<%= tab === 'sikayet' ? 'aktif' : '' %>">Şikayetler <span class="rozet"><%= c.sikayet %></span></a>
  <a href="?tab=iletisim" class="<%= tab === 'iletisim' ? 'aktif' : '' %>">📮 İletişim<% if (c.iletisim) { %> <span class="rozet"><%= c.iletisim %></span><% } %></a>
  <a href="?tab=siparis" class="<%= tab === 'siparis' ? 'aktif' : '' %>">📦 Siparişler (<%= c.acik_siparis %> açık)<% if (c.itiraz) { %> <span class="rozet"><%= c.itiraz %> itiraz</span><% } %></a>
  <a href="?tab=ilan" class="<%= tab === 'ilan' ? 'aktif' : '' %>">İlanlar (<%= c.ilan %>)</a>
  <a href="?tab=uye" class="<%= tab === 'uye' ? 'aktif' : '' %>">Üyeler (<%= c.uye %>)</a>
  <a href="?tab=fiyatlar" class="<%= tab === 'fiyatlar' ? 'aktif' : '' %>">💰 Fiyatlar</a>
  <a href="?tab=kargo" class="<%= tab === 'kargo' ? 'aktif' : '' %>">🚚 Kargo ve vitrin</a>
  <a href="?tab=kelimeler" class="<%= tab === 'kelimeler' ? 'aktif' : '' %>">🚫 Yasaklı kelimeler</a>
  <a href="?tab=yedek" class="<%= tab === 'yedek' ? 'aktif' : '' %>">💾 Yedekler</a>
</nav>

<% if (!rows.length && !['fiyatlar', 'kelimeler', 'yedek', 'kargo', 'uye'].includes(tab)) { %><div class="bos-durum"><p>Burada gösterilecek kayıt yok.</p></div><% } %>

<% if (['bekleyen', 'aktif', 'gecmis'].includes(tab)) { %>
  <div class="admin-liste">
  <% rows.forEach(function (ad) { %>
    <article class="admin-kart">
      <div class="admin-kart-bas">
        <% if (ad.image) { %><img class="reklam-logo" src="/uploads/<%= ad.image %>" alt=""><% } %>
        <div>
          <strong><%= ad.business_name %></strong>
          <small>📍 <%= konumAdi(ad.il, ad.ilce) %><%= ad.ilce ? '' : ' (il geneli)' %> · Alan <%= ad.slot %> · <%= ad.months %> ay · <strong><%= ad.price ? fiyat(ad.price) : 'fiyat yok' %></strong> · Ref: <code><%= ad.ref_code %></code></small>
        </div>
        <span class="durum durum-<%= ad.status %>"><%= { pending: 'Bekliyor', active: 'Yayında', rejected: 'Reddedildi', ended: 'Bitti' }[ad.status] %></span>
      </div>
      <p><%= ad.description %></p>
      <p class="kucuk">
        <% if (ad.phone) { %>📞 <%= ad.phone %> · <% } %><% if (ad.website) { %>🔗 <%= ad.website %> · <% } %>
        👤 <%= ad.contact_name %> (<a href="mailto:<%= ad.contact_email %>"><%= ad.contact_email %></a>) · Başvuru: <%= tarih(ad.created_at) %>
        <% if (ad.status === 'active') { %><br>Yayın: <%= tarih(ad.start_date) %> – <%= tarih(ad.end_date) %> · <%= ad.impressions %> gösterim · <%= ad.clicks %> tıklama<% } %>
        <% if (ad.admin_note) { %><br>Not: <%= ad.admin_note %><% } %>
      </p>
      <% if (ad.status === 'pending') { %>
        <form method="post" action="/yonetim/reklam/<%= ad.id %>/onayla" class="admin-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>Alan <select name="slot"><% for (let i = 1; i <= SLOT_SAYISI; i++) { %><option <%= ad.slot === i ? 'selected' : '' %>><%= i %></option><% } %></select></label>
          <label>Ay <input type="number" name="months" min="1" max="24" value="<%= ad.months %>"></label>
          <input name="note" placeholder="Not (ör. ödeme alındı)">
          <button class="btn btn-mini btn-yesil" data-confirm="<%= ad.ref_code %> referanslı ödeme hesabına geçti mi? Reklam yayına alınacak.">Ödeme alındı → Yayınla</button>
          <button class="btn btn-mini btn-cizgi kirmizi" formaction="/yonetim/reklam/<%= ad.id %>/reddet">Reddet</button>
        </form>
      <% } else if (ad.status === 'active') { %>
        <% if (ad.renew_months) { %><p class="flash flash-info">🔁 Uzatma talebi: +<%= ad.renew_months %> ay, <%= ad.renew_price ? fiyat(ad.renew_price) : 'fiyat yok' %> (Ref: <%= ad.ref_code %>)</p><% } %>
        <form method="post" action="/yonetim/reklam/<%= ad.id %>/uzat" class="admin-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>+ <input type="number" name="months" min="1" max="24" value="<%= ad.renew_months || 1 %>"> ay</label>
          <button class="btn btn-mini btn-yesil"><%= ad.renew_months ? 'Ödeme alındı → Uzat' : 'Süreyi uzat' %></button>
          <% if (ad.renew_months) { %><button class="btn btn-mini btn-cizgi" formaction="/yonetim/reklam/<%= ad.id %>/uzatma-iptal">Talebi sil</button><% } %>
          <button class="btn btn-mini btn-cizgi kirmizi" formaction="/yonetim/reklam/<%= ad.id %>/durdur" data-confirm="Reklam yayından kaldırılsın mı?">Yayından kaldır</button>
        </form>
      <% } %>
    </article>
  <% }) %>
  </div>
<% } else if (tab === 'onay') { %>
  <div class="admin-liste">
  <% rows.forEach(function (l) { %>
    <article class="admin-kart">
      <p><a href="/ilan/<%= l.id %>"><strong><%= l.title %></strong></a> <small class="kucuk">· <%= l.seller %> · <%= konumAdi(l.il, l.ilce) %> · <%= tarih(l.created_at) %></small></p>
      <p class="kucuk">🚩 Yakalanan: <strong><%= l.mod_reason %></strong></p>
      <p><%= l.description.slice(0, 300) %></p>
      <div class="admin-form">
        <form method="post" action="/yonetim/ilan/<%= l.id %>/durum"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="onay"><button name="status" value="active" class="btn btn-mini btn-yesil">Onayla, yayınla</button></form>
        <form method="post" action="/yonetim/ilan/<%= l.id %>/durum"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="onay"><button name="status" value="rejected" class="btn btn-mini btn-cizgi kirmizi">Reddet</button></form>
      </div>
    </article>
  <% }) %>
  </div>
<% } else if (tab === 'siparis') { %>
  <p class="kucuk">Tamamlanan: <strong><%= ciro.n %></strong> sipariş · İşlem hacmi <strong><%= fiyat(ciro.hacim) %></strong> · Hizmet bedeli geliri <strong><%= fiyat(ciro.hizmet) %></strong> (ödeme kuruluşu kesintisi hariç)</p>
  <div class="admin-liste">
  <% rows.forEach(function (o) { %>
    <article class="admin-kart">
      <div class="admin-kart-bas">
        <div><a href="/siparis/<%= o.code %>"><strong><%= o.code %> · <%= o.title %></strong></a>
          <small><%= o.buyer %> → <%= o.seller %> · <%= fiyat(o.total) %> (hizmet <%= fiyat(o.service_fee) %>) · <%= o.provider %> · <%= tarih(o.created_at) %></small></div>
        <span class="durum durum-<%= o.status %>"><%= DURUMLAR[o.status] %></span>
      </div>
      <% if (o.dispute_reason) { %><p>⚠️ <strong>İtiraz:</strong> <%= o.dispute_reason %></p><% } %>
      <% if (o.carrier) { %><p class="kucuk">🚚 <%= o.carrier %> · <%= o.tracking_no %></p><% } %>
      <% if (['odendi', 'kargoda', 'itiraz'].includes(o.status)) { %>
        <form method="post" action="/yonetim/siparis/<%= o.id %>/aktar" class="admin-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input name="note" placeholder="Not (taraflara iletilir)">
          <button class="btn btn-mini btn-yesil" data-confirm="Ödeme satıcıya aktarılacak. Emin misin?">Satıcıya aktar</button>
          <button class="btn btn-mini btn-cizgi kirmizi" formaction="/yonetim/siparis/<%= o.id %>/iade" data-confirm="Tutarın tamamı alıcıya iade edilecek. Emin misin?">Alıcıya iade et</button>
        </form>
      <% } %>
    </article>
  <% }) %>
  </div>
<% } else if (tab === 'kargo') { %>
  <form method="post" action="/yonetim/kargo" class="kart-form form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <p class="kucuk">Ödeme sağlayıcısı: <strong><%= saglayici %></strong><%= saglayici === 'test' ? ' — gerçek para hareketi yok. .env dosyasına IYZICO_API_KEY ve IYZICO_SECRET_KEY girince iyzico kullanılır.' : '' %></p>
    <h2 class="form-baslik">Kargo ücretleri (alıcı öder, satıcıya aktarılır)</h2>
    <div class="iki-kolon">
      <% PAKETLER.forEach(function (p) { %><label><%= p.ad %> <small>(<%= p.aciklama %>)</small><input name="kargo_<%= p.key %>" inputmode="numeric" value="<%= kargoAyar[p.key] %>"></label><% }) %>
    </div>
    <h2 class="form-baslik">Güvenli ödeme hizmet bedeli (alıcı öder, sitede kalır)</h2>
    <div class="iki-kolon">
      <label>Ürün fiyatının yüzdesi (%)<input name="hizmet_yuzde" inputmode="decimal" value="<%= kargoAyar.hizmetYuzde %>"></label>
      <label>En az (TL)<input name="hizmet_min" inputmode="numeric" value="<%= kargoAyar.hizmetMin %>"></label>
    </div>
    <p class="kucuk">Elden teslim ilanlar 0₺ komisyonla devam eder; bu bedel sadece kargolu güvenli ödemede alınır. iyzico'nun işlem kesintisi bu bedelden karşılanır.</p>
    <h2 class="form-baslik">⭐ Vitrin fiyatları (TL)</h2>
    <p class="kucuk">Şu an vitrinde <strong><%= vitrinAktif %></strong> ilan var · Toplam <strong><%= vitrinCiro.n %></strong> vitrin satışı, <strong><%= fiyat(vitrinCiro.toplam) %></strong> gelir.</p>
    <div class="iki-kolon">
      <% vitrinAyar.forEach(function (p) { %><label><%= p.gun %> gün vitrin<input name="vitrin_<%= p.gun %>" inputmode="numeric" value="<%= p.fiyat %>"></label><% }) %>
    </div>
    <button class="btn btn-yesil">Kaydet</button>
  </form>
<% } else if (tab === 'fiyatlar') { %>
  <form method="post" action="/yonetim/fiyatlar" class="kart-form form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2 class="form-baslik">Aylık reklam fiyatları (TL)</h2>
    <p class="kucuk">Boş bırakılan fiyatlar sitede "Teklif alın" olarak görünür. Değişiklik yeni başvurulara uygulanır.</p>
    <div class="tablo-sar"><table class="tablo">
      <thead><tr><th>Grup</th><th>İlçe reklamı / ay</th><th>İl geneli reklam / ay</th></tr></thead>
      <tbody>
      <% gruplar.forEach(function (g) { %>
        <tr><td><%= g.ad %></td>
          <td><input name="ilce_<%= g.key %>" inputmode="numeric" value="<%= fiyatTablo[g.key].ilce || '' %>" placeholder="örn. 500"></td>
          <td><input name="il_<%= g.key %>" inputmode="numeric" value="<%= fiyatTablo[g.key].il || '' %>" placeholder="örn. 1500"></td></tr>
      <% }) %>
      </tbody>
    </table></div>
    <button class="btn btn-yesil">Fiyatları kaydet</button>
  </form>
  <form method="post" action="/yonetim/fiyatlar/ozel" class="kart-form form" style="margin-top:16px">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2 class="form-baslik">Belirli bir il/ilçe için özel fiyat</h2>
    <p class="kucuk">Örneğin Kadıköy veya Çankaya'yı grubundan daha pahalı yapmak için. Fiyatı boş bırakırsan özel fiyat silinir.</p>
    <div class="iki-kolon"><%- include('partials/location-select', { secIl: '', secIlce: '', ilBos: 'İl seçin', ilceBos: 'İl geneli', zorunlu: true, ilceOpsiyonel: true }) %></div>
    <label>Aylık fiyat (TL)<input name="price" inputmode="numeric"></label>
    <button class="btn btn-yesil">Kaydet</button>
    <% if (ozel.length) { %>
      <div class="tablo-sar"><table class="tablo"><thead><tr><th>Konum</th><th>Aylık</th></tr></thead><tbody>
        <% ozel.forEach(function (o) { %><tr><td><%= konumAdi(o.il, o.ilce) %><%= o.ilce ? '' : ' (il geneli)' %></td><td><%= fiyat(o.price) %></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
  </form>
<% } else if (tab === 'kelimeler') { %>
  <form method="post" action="/yonetim/kelimeler" class="kart-form form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <p class="kucuk">Her satıra bir kelime veya ifade yaz. Bunlardan birini içeren ilanlar yayına girmez, "Onay bekleyen ilanlar" sekmesine düşer. Kelimenin ek almış hâlleri de yakalanır (ör. "kapora" → "kaporası"). IBAN numaraları her zaman yakalanır. # ile başlayan satırlar not kabul edilir.</p>
    <textarea name="kelimeler" rows="18"><%= kelimeler %></textarea>
    <button class="btn btn-yesil">Kaydet</button>
  </form>
<% } else if (tab === 'yedek') { %>
  <div class="kart-form">
    <p>Veritabanı her gün otomatik olarak yedeklenir, fotoğraflar artımlı olarak kopyalanır. Son <strong><%= keep %></strong> günün yedeği tutulur.</p>
    <p class="kucuk">Yedek klasörü: <code><%= yedekDir %></code></p>
    <form method="post" action="/yonetim/yedek"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-yesil">Şimdi yedek al</button></form>
    <% if (yedekler.length) { %>
      <div class="tablo-sar" style="margin-top:14px"><table class="tablo"><thead><tr><th>Dosya</th><th>Boyut</th></tr></thead><tbody>
        <% yedekler.forEach(function (y) { %><tr><td><%= y.f %></td><td><%= (y.size / 1024).toFixed(0) %> KB</td></tr><% }) %>
      </tbody></table></div>
    <% } else { %><p class="kucuk">Henüz yedek yok.</p><% } %>
  </div>
<% } else if (tab === 'sikayet') { %>
  <div class="admin-liste">
  <% rows.forEach(function (r) { %>
    <article class="admin-kart">
      <p><a href="/ilan/<%= r.lid %>"><strong><%= r.title %></strong></a> <small>(<%= r.lstatus %>) · <%= tarih(r.created_at) %> · İlan sahibi: <a href="/yonetim?tab=uye&q=<%= r.owner_id %>"><%= r.owner_name %></a><%= r.owner_banned ? ' 🚫' : '' %></small></p>
      <p><%= r.reason %></p>
      <div class="admin-form">
        <form method="post" action="/yonetim/ilan/<%= r.lid %>/durum"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="sikayet"><button name="status" value="removed" class="btn btn-mini btn-cizgi kirmizi">İlanı kaldır</button></form>
        <form method="post" action="/yonetim/sikayet/<%= r.id %>/kapat"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-mini btn-cizgi">Şikayeti kapat</button></form>
        <% if (!r.owner_banned) { %><form method="post" action="/yonetim/uye/<%= r.owner_id %>/engelle"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="/yonetim?tab=sikayet"><input type="hidden" name="reason" value="<%= r.reason.slice(0, 280) %>">
          <button class="btn btn-mini btn-kirmizi" data-confirm="<%= r.owner_name %> kalıcı olarak engellensin mi? Tüm ilanları ve reklamları yayından kalkacak.">🚫 Sahibini kalıcı engelle</button></form><% } %>
      </div>
    </article>
  <% }) %>
  </div>
<% } else if (tab === 'ilan') { %>
  <div class="tablo-sar"><table class="tablo">
    <thead><tr><th>#</th><th>Başlık</th><th>Konum</th><th>Satıcı</th><th>Durum</th><th></th></tr></thead>
    <tbody><% rows.forEach(function (l) { %>
      <tr><td><%= l.id %></td><td><a href="/ilan/<%= l.id %>"><%= l.title %></a></td><td><%= konumAdi(l.il, l.ilce) %></td><td><%= l.seller %></td><td><%= l.status %></td>
        <td><form method="post" action="/yonetim/ilan/<%= l.id %>/durum"><input type="hidden" name="_csrf" value="<%= csrf %>">
          <% if (l.status === 'removed') { %><button name="status" value="active" class="btn btn-mini btn-cizgi">Geri al</button><% } else { %><button name="status" value="removed" class="btn btn-mini btn-cizgi kirmizi">Kaldır</button><% } %>
        </form></td></tr>
    <% }) %></tbody>
  </table></div>
<% } else if (tab === 'uye') { %>
  <form method="get" class="uye-ara"><input type="hidden" name="tab" value="uye">
    <input type="search" name="q" value="<%= uyeAra %>" placeholder="Ad, e-posta veya üye no ile ara" aria-label="Üye ara"><button class="btn btn-yesil btn-mini">Ara</button></form>
  <% if (!rows.length) { %><div class="bos-durum"><p>Üye bulunamadı.</p></div><% } %>
  <div class="tablo-sar"><table class="tablo">
    <thead><tr><th>#</th><th>Ad</th><th>E-posta</th><th>İlan</th><th>Şikayet</th><th>Kayıt</th><th></th></tr></thead>
    <tbody><% rows.forEach(function (u) { %>
      <tr class="<%= u.banned_at ? 'engelli-satir' : '' %>"><td><%= u.id %></td>
        <td><a href="/uye/<%= u.id %>"><%= u.name %></a><%= u.is_admin ? ' (yönetici)' : '' %><%= u.email_verified ? ' ✅' : '' %><%= u.google_id ? ' · G' : '' %>
          <% if (u.banned_at) { %><br><small class="kirmizi-yazi">🚫 <%= tarih(u.banned_at) %> engellendi<%= u.ban_reason ? ': ' + u.ban_reason : '' %></small><% } %></td>
        <td><%= u.email %></td><td><%= u.ilan_sayisi %></td><td><%= u.sikayet_sayisi || '' %></td><td><%= tarih(u.created_at) %></td>
        <td>
          <% if (u.banned_at) { %>
            <form method="post" action="/yonetim/uye/<%= u.id %>/engel-kaldir"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-cizgi btn-mini" data-confirm="<%= u.name %> için engel kaldırılsın mı?">Engeli kaldır</button></form>
          <% } else if (!u.is_admin && u.id !== user.id) { %>
            <details class="engel-detay"><summary class="btn btn-cizgi btn-mini kirmizi">Engelle</summary>
              <form method="post" action="/yonetim/uye/<%= u.id %>/engelle"><input type="hidden" name="_csrf" value="<%= csrf %>">
                <input name="reason" maxlength="300" placeholder="Neden (üyeye e-postayla bildirilir)">
                <button class="btn btn-kirmizi btn-mini" data-confirm="<%= u.name %> kalıcı olarak engellensin mi? İlanları ve reklamları yayından kalkacak.">Kalıcı engelle</button></form></details>
          <% } %>
        </td></tr>
    <% }) %></tbody>
  </table></div>
<% } else if (tab === 'iletisim') { %>
  <div class="admin-liste">
  <% rows.forEach(function (m) { %>
    <article class="admin-kart <%= m.status === 'open' ? '' : 'soluk' %>">
      <div class="admin-kart-bas"><div><strong><%= m.topic %></strong> <small>· <%= m.name %> · <a href="mailto:<%= m.email %>?subject=<%= encodeURIComponent('Re: ' + m.topic) %>"><%= m.email %></a> · <%= tarihSaat(m.created_at) %></small></div>
        <span class="durum durum-<%= m.status === 'open' ? 'pending' : 'ended' %>"><%= m.status === 'open' ? 'Yeni' : 'Kapandı' %></span></div>
      <p class="onceki-satir"><%= m.body %></p>
      <% if (m.status === 'open') { %><div class="admin-islemler">
        <a class="btn btn-yesil btn-mini" href="mailto:<%= m.email %>?subject=<%= encodeURIComponent('Re: ' + m.topic) %>">✉️ Yanıtla</a>
        <form method="post" action="/yonetim/iletisim/<%= m.id %>/kapat"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-cizgi btn-mini">Kapat</button></form></div><% } %>
    </article>
  <% }) %>
  </div>
<% } %>
<%- include('partials/foot') %>
