# Kopyalayıp .env yapın ya da sunucuda ortam değişkeni olarak tanımlayın
PORT=3000
NODE_ENV=production
# Uzun, rastgele bir değer verin (oturumlar sunucu yeniden başlayınca da geçerli kalsın)
SESSION_SECRET=buraya-uzun-rastgele-bir-deger-yazin
# Bu e-posta ile kayıt olan hesap yönetici olur. Boşsa ilk kayıt olan kullanıcı yönetici olur.
ADMIN_EMAIL=
# Aylık reklam fiyatları (TL). Boş bırakılırsa sayfada "Teklif alın" yazar.
AD_PRICE_ILCE=
AD_PRICE_IL=
# İsteğe bağlı: veritabanı ve yüklenen görseller için kalıcı klasörler
# DB_PATH=/var/data/havuc.db
# UPLOAD_DIR=/var/data/uploads
# HTTPS arkasında değilseniz (yerel test) güvenli çerezi kapatmak için:
# COOKIE_SECURE=0
