# Bu dosyayı ".env" adıyla kopyalayın ve ihtiyacınız olan satırları doldurun.
# Kendi bilgisayarınızda denemek için hiçbir şeyi doldurmanız gerekmez.

PORT=3000
# Yayına aldığınızda sitenin adresi (e-postalardaki bağlantılar ve paylaşım önizlemeleri için)
SITE_URL=
# Bu e-posta ile kayıt olan hesap yönetici olur. Boşsa ilk kayıt olan kullanıcı yönetici olur.
ADMIN_EMAIL=

# --- Havale/EFT bilgileri (reklam ödemeleri) ---
BANK_IBAN=
BANK_HOLDER=
BANK_NAME=

# --- E-posta (doğrulama, şifre sıfırlama, bildirimler) ---
# Boş bırakılırsa e-postalar gönderilmez; terminale ve data/epostalar klasörüne yazılır.
# Örnek (Gmail uygulama şifresi): SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=...@gmail.com SMTP_PASS=...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Havuç Takas <no-reply@alanadiniz.com>
# SMTP tanımlıysa e-posta doğrulaması varsayılan olarak zorunludur. Kapatmak için 0, açmak için 1.
REQUIRE_EMAIL_VERIFICATION=

# --- Cloudflare Turnstile (bot koruması, ücretsiz: dash.cloudflare.com → Turnstile) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Ziyaretçi istatistiği (çerezsiz) — birini doldurun ---
# Umami: UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js  UMAMI_WEBSITE_ID=...
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
# Plausible: PLAUSIBLE_DOMAIN=alanadiniz.com
PLAUSIBLE_DOMAIN=

# --- Yedekleme (günde bir kez otomatik) ---
# BACKUP_DIR=          (varsayılan: data/yedekler — başka bir diske/klasöre almanız önerilir)
# BACKUP_KEEP_DAYS=14
# BACKUP_DISABLED=1

# --- Yayın ayarları ---
# NODE_ENV=production
# SESSION_SECRET=      (boşsa otomatik üretilir ve data/.session-secret dosyasında saklanır)
# DB_PATH=/var/data/havuc.db
# UPLOAD_DIR=/var/data/uploads
